# CometChat app credentials (app.cometchat.com -> your app -> API & Auth Keys)
# Or run: npx @cometchat/skills-cli@3 auth login && npx @cometchat/skills-cli@3 provision run
COMETCHAT_APP_ID=
COMETCHAT_REGION=in
# REST API key with fullAccess scope. Server-side only, never shipped to the browser.
COMETCHAT_REST_API_KEY=

# Who is who in the demo
AGENT_UID=pager-agent
AGENT_NAME=Pager
GROUP_GUID=ship-it
GROUP_NAME=Ship It
# Comma-separated "uid:Display Name" humans. Only these can log in and command the agent.
HUMANS=hridya:Hridya,sam:Sam

# How the agent hears messages:
#   poll     - the server polls the group via REST (works with zero dashboard setup)
#   callback - CometChat Custom Agent relays messages to POST /cometchat/callback
#              (set the dashboard callback URL to https://<tunnel>/cometchat/callback)
AGENT_MODE=poll
CALLBACK_USER=pager
CALLBACK_PASS=change-me

# The folder the agent is allowed to touch. Nothing outside it.
WORKSPACE_DIR=../workspace
# Command used to run Claude Code headless
CLAUDE_BIN=claude
# Set to 1 to fake the agent (no Claude usage) - handy for rehearsing the UI
MOCK_AGENT=0

PORT=8787
